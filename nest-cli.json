{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "assets": [
      "mail/template/*",
      "apps/api/public/*",
      {
        "include": "public/*",
        "outDir": "dist/apps/api",
        "watchAssets": true
      },
      {
        "include": "view/*",
        "outDir": "dist/apps/api",
        "watchAssets": true
      }
    ],
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/api",
  "projects": {
    "queue-service": {
      "type": "application",
      "root": "apps/queue-service",
      "entryFile": "main",
      "sourceRoot": "apps/queue-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/queue-service/tsconfig.app.json",
        "assets": [
          {
            "include": "mail/template/*",
            "outDir": "dist/apps/queue-service",
            "watchAssets": true
          }
        ]
      }
    },
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "@app/shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "assets": [
        {
          "include": "views/**/*",
          "outDir": "dist"
        }
      ],
      "watchAssets": true
    }
  }
}