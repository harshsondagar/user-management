{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/e2e/global-setup.ts",
  "setupFilesAfterEnv": [
    "<rootDir>/e2e/setup.ts"
  ],
  "testMatch": [
    "<rootDir>/e2e/specs/**/*.e2e-spec.ts",
    "<rootDir>/e2e/specs/**/*.spec.ts"
  ],
  "moduleNameMapper": {
    "^@app/shared(|/.*)$": "<rootDir>/../../../libs/shared/src/$1"
  }
}