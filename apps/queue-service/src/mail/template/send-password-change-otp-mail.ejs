<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Forgot Password</title>
</head>

<body>
    <div class="container">
        <h2>Forgot Password</h2>
        <% if (locals.message) { %>
            <p style="color: green;">
                <%= message %>
            </p>
            <% } %>
                <% if (locals.resetUrl) { %>
                    <p><a href="<%= resetUrl %>">Click here to change your password</a></p>
                    <% } %>
    </div>
</body>

</html>